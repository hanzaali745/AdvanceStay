# Database
DATABASE_URL=postgresql://postgres:password@localhost/thenextgenai

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Email
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key-here
FROM_EMAIL=editorial@thenextgenai.com

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000", "https://thenextgenai.com"]

# Analytics
ANALYTICS_ENABLED=true

# Environment
ENVIRONMENT=development
DEBUG=true

# Trending
TRENDING_RECALC_HOURS=6
TRENDING_MIN_VIEWS=10
TRENDING_DATE_RANGE_DAYS=7

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
